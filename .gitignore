# Pipeline outputs (everything lands under results/ by default)
results/
results.*/
apr7_backup/

# Snakemake state
.snakemake/

# Local config (copied from config.example.yaml)
config.yaml

# Tool downloads
*.jar

# Misc workdirs
work/
tmp/
logs/
refs/
build_scratch/

# Test fixture (generated by tests/make_fixture.py) and test run dirs
tests/data/
tests/.run/
tests/.pytest_cache/
.pytest_cache/
__pycache__/
